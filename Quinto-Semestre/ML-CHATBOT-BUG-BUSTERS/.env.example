# ⚙️ VARIÁVEIS DE AMBIENTE - CHATBOT GEMINI
# 
# Copie este arquivo para .env e preencha com suas chaves
# NUNCA commit deste arquivo em repositório publico!
#
# Como obter a chave:
# 1. Acesse: https://aistudio.google.com/app/apikey
# 2. Clique em "Create API Key"
# 3. Copie a chave gerada
# 4. Cole aqui

# ─────────────────────────────────────────────────────────
# GOOGLE GEMINI API
# ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_api_key_here

# ─────────────────────────────────────────────────────────
# CONFIGURAÇÕES OPCIONAIS
# ─────────────────────────────────────────────────────────
DEBUG_MODE=false
CLINICA_NOME=Clínica de Biomedicina
CLINICA_TELEFONE=192
